  m_Script: {fileID: 11500000, guid: fbb0b7ca83a252c418a87c8ce8a465ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  gameManager: {fileID: 84319912}
  fatherStep: {fileID: 949765307}
  botText: {fileID: 1402265429}
  panel: {fileID: 909406670}
  canvasPointer: {fileID: 440250227}
  bot: {fileID: 1424672685}
  afterEndStep: 1
  canvasEndToggle: 1
  typingSpeed: 0.05
  ItalianSentences:
  - Ti ha mandato quel modello di Angel Bot, giusto?
  - Non si fa mai gli affari suoi!
  - Ma magari stavolta ne ha fatta una giusta, avrei bisogno di una mano
  - La Garden Dome ha visto come ostile quel cubo sulla bilancia.
  - "Ha creato un campo di forza e adesso non posso pi\xF9 misurare la densit\xE0
    direttamente"
  - "Per\xF2 magari con gli strumenti giusti tu potresti riuscirci"
  EnglishSentences:
  - Did that Angel Bot model send you here, right?
  - He never minds his own business!
  - But maybe he did it right this time, you can help me
  - The Garden Dome saw that cube on the scale as hostile.
  - It created a force field and now I can no longer measure the density directly
  - But maybe with the right tools you could do it
  toActivateAtEnd: []
  dialogAudioSource: {fileID: 1424672686}
  sentenceClips:
  - {fileID: 8300000, guid: 36c86171f0d4c2843a3ea447881b853c, type: 3}
