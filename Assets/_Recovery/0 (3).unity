  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  gameManager: {fileID: 84319912}
  fatherStep: {fileID: 929292075}
  botText: {fileID: 2055804399}
  panel: {fileID: 352826430}
  canvasPointer: {fileID: 1863628836}
  bot: {fileID: 2125395821}
  afterEndStep: 1
  canvasEndToggle: 1
  typingSpeed: 0.05
  ItalianSentences:
  - "Guarda un p\xF2 chi si vede! Ho sentito ti sei rimesso in pista."
  - Capiti al momento giusto. Uno sbullonato ha perso i dati dell'inerzia di sfera
    e cilndro nel settore C137.
  - Mi hano chiesto di ricaricare quei dati da qui.
  - Cubot, potresti gentilmente spiegare al nostro collega cosa bisogna fare?
  EnglishSentences:
  - Look who's here! I heard you're back on track.
  - You're in the nick of time. An unbolted has lost the sphere and cylinder inertia
    data in sector C137.
  - The headquarters asked me to reload that data from here.
  - Cubot, could you kindly explain to our colleague what needs to be done?
  toActivateAtEnd: []
  dialogAudioSource: {fileID: 2125395825}
  sentenceClips:
