  m_Script: {fileID: 11500000, guid: fbb0b7ca83a252c418a87c8ce8a465ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  gameManager: {fileID: 84319912}
  fatherStep: {fileID: 692968591}
  botText: {fileID: 1722589314}
  panel: {fileID: 1186484113}
  canvasPointer: {fileID: 639265793}
  bot: {fileID: 1330588979}
  afterEndStep: 1
  canvasEndToggle: 1
  typingSpeed: 0.05
  ItalianSentences:
  - "Certo red bot! Non \xE8 troppo complesso. Per iniziare prova a calcolare l'altezza
    della rampa."
  - Dato che ci servira per dopo. Metti la rampa a 30 gradi.
  - Per farlo usa la manopola del selettore angolare dietro di te, quel cubo nero
    con i pulsanti.
  - Poi usa la formula card "altezza"  per ricavare l'altezza della rampa a quella
    inclinazione
  EnglishSentences:
  - Sure, red bot! It's not too complex. To start, try calculating the height of
    the ramp.
  - Since we'll need this later. Set the ramp to 30 degrees.
  - To do this, use the angle selector knob behind you, that black cube with the
    buttons.
  - Then use the "height" card formula to find the height of the ramp at that angle.
  toActivateAtEnd: []
  dialogAudioSource: {fileID: 1330588985}
  sentenceClips:
  - {fileID: 8300000, guid: 36c86171f0d4c2843a3ea447881b853c, type: 3}
  - {fileID: 8300000, guid: 36c86171f0d4c2843a3ea447881b853c, type: 3}
