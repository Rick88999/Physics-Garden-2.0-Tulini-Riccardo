  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  gameManager: {fileID: 84319912}
  fatherStep: {fileID: 1171898101}
  botText: {fileID: 1638518260}
  panel: {fileID: 1504726136}
  canvasPointer: {fileID: 1525408282}
  bot: {fileID: 615575289}
  afterEndStep: 1
  canvasEndToggle: 1
  typingSpeed: 0.05
  ItalianSentences:
  - Grandioso!
  - Con le mani potrai raccogliere durante il tuo viaggio degli oggetti
  - Questi ti aiuteranno nelle tue missioni
  - Puoi afferrarli come hai afferrato prima il cubo o richiamarli a te con l'attrattore
  EnglishSentences:
  - Great!
  - With your hands you will be able to collect objects during your journey
  - These will help you on your missions
  - You can grab them like you grabbed the cube before or call them back to you with
    the gravity gun
  toActivateAtEnd: []
  dialogAudioSource: {fileID: 615575293}
