  m_Script: {fileID: 11500000, guid: fbb0b7ca83a252c418a87c8ce8a465ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogManager
  gameManager: {fileID: 84319912}
  fatherStep: {fileID: 1106466033}
  botText: {fileID: 1644550547}
  panel: {fileID: 1259891056}
  canvasPointer: {fileID: 1593606399}
  bot: {fileID: 963334290}
  afterEndStep: 1
  canvasEndToggle: 1
  typingSpeed: 0.05
  ItalianSentences:
  - Aiuto! Oh no come faro! Sono nei guai seri!
  - Ehi tu! Puoi aiutarmi?
  - "Il mio carretto si \xE8 rotto mentre andavo alla sede centrale per analizzare
    la densit\xE0 di questo masso"
  - Ma adesso non arrivero mai in tempo
  - Qui ho tutto il necessario per analizzare la massa, ma non ho delle mani astrali
    con me
  - Potreste pensarci voi?
  - "Il tuo compagno bot ti spiegher\xE0 come fare... io devo chiamare i soccorsi"
  EnglishSentences:
  - Help! Oh no, how can I do it? I'm in serious trouble!
  - Hey! Can you help me?
  - My cart broke down on my way to headquarters. I have to analyze the density of
    this boulder.
  - But now I'll never get there in time
  - Here I have everything I need to analyze the mass, but I don't have any astral
    hands with me.
  - Could you think about it?
  - Your bot buddy will tell you what to do... I must call for help.
  toActivateAtEnd: []
  dialogAudioSource: {fileID: 963334293}
  sentenceClips:
  - {fileID: 8300000, guid: b8df0ecd53156184e9f89de551eb9520, type: 3}
